<%# Carte « ticket » d'un événement. Paramètre : e (événement avec association peuplée) %>
<% const d = new Date(e.date); const complet = e.nbInscrits >= e.capacite; const taux = Math.min(100, Math.round(e.nbInscrits / e.capacite * 100)); %>
<article class="ticket <%= complet ? 'ticket--complet' : '' %>">
  <div class="ticket__talon" aria-hidden="true">
    <span class="ticket__jour"><%= d.getDate() %></span>
    <span class="ticket__mois"><%= d.toLocaleDateString('fr-FR', { month: 'short' }) %></span>
    <span class="ticket__heure"><%= d.toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' }) %></span>
  </div>
  <div class="ticket__corps">
    <p class="ticket__categorie categorie categorie--<%= e.categorie %>"><%= categories[e.categorie] %></p>
    <h3 class="ticket__titre"><a href="/evenements/<%= e._id %>"><%= e.titre %></a></h3>
    <p class="ticket__infos">
      <time datetime="<%= d.toISOString() %>" class="visuellement-cache"><%= formaterDate(d) %></time>
      <%= e.lieu %><% if (e.association && e.association.nom) { %>, par <%= e.association.nom %><% } %>
    </p>
    <div class="jauge" title="<%= e.nbInscrits %> inscrits sur <%= e.capacite %> places">
      <div class="jauge__barre"><span style="--taux: <%= taux %>%"></span></div>
      <span class="jauge__texte"><%= complet ? 'Complet' : (e.capacite - e.nbInscrits) + ' place' + (e.capacite - e.nbInscrits > 1 ? 's' : '') + ' libre' + (e.capacite - e.nbInscrits > 1 ? 's' : '') %></span>
    </div>
  </div>
</article>
